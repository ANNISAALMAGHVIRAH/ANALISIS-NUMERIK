import numpy as np
import matplotlib.pyplot as plt

# Data
x = np.array([10, 20, 30,40]) # ukuran aplikasi (MB)
y = np.array([2.5, 4, 5, 6.5]) # waktu muak (detik)

# Hitung parameter regresi
n = len(x)
x_mean = np.mean(x)
y_mean = np.mean(y)

# Rumus slope(b1) dan intercept (b0)
b1 = np.sum((x - x_mean) * (y - y_mean)) / np.sum((x - x_mean)**2)
b0 = y_mean - b1 * x_mean

print("Persamaan regresi: y = {:.4f}x + {:.4f}".format(b1, b0))

def predict(x_new):
    return b0 + b1 * x_new

# Contoh prediksi
print("Prediksi waktu muat untuk ukuran 35 MB:", predict(35))

x_plot = np.linspace(min(x), max(x), 100)
y_plot = [predict(x_val) for x_val in x_plot]
plt.plot(x_plot, y_plot, label='Regresi Linear')
plt.scatter(x, y, color='red', label='Data')
plt.xlabel('Ukuran Aplikasi (MB)')
plt.ylabel('Waktu Muak (detik)')
plt.legend()
plt.show()

